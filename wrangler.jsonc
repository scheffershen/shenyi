{
  // Deploy configuration for the shenyi.dev Worker.
  //
  // The Cloudflare build runs `npx wrangler deploy`. Without this file
  // wrangler generates an equivalent one on every build, which means the
  // deploy settings - including compatibility_date, which it sets to the
  // build date - could change without a commit. Committing it pins them.
  //
  // "assets.directory" is the repository root, so .assetsignore controls
  // which files are actually published.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shenyi",
  "compatibility_date": "2026-10-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  }
}
